#!/bin/bash
# musicle-cli yt-dlp wrapper.
#  - Strips the broken "--extractor-args youtube:player_client=web" argument.
#  - Retries transient YouTube errors (403/throttle) with webm-capable clients.
#  - Stderr is NOT echoed to the terminal (avoids console spam); it is logged to
#    /tmp/musicle_ytwrap.log for debugging. The app shows only its own status.
#  - stdout (audio bytes for the -o - path) is passed through untouched.
REAL="$(dirname "$0")/yt-dlp.real"
LOG="/tmp/musicle_ytwrap.log"

# Build CLEAN args (strip the stale player_client=web override; current
# yt-dlp auto-selects a working client itself).
CLEAN=()
while [ $# -gt 0 ]; do
  if [ "$1" = "--extractor-args" ]; then
    if [ "$2" != "${2#*player_client=web}" ]; then shift 2; continue
    else CLEAN+=("$1"); shift; CLEAN+=("$2"); shift; continue; fi
  fi
  if [ "$1" = "youtube:player_client=web" ]; then shift; continue; fi
  CLEAN+=("$1"); shift
done

# Kept small on purpose: with an up-to-date yt-dlp the first attempt usually
# succeeds in seconds. Retries use only real, audio-capable clients; long
# retry spirals only stall playlists.
CLIENTS=(android ios tv)
MAX_TRIES=3
rc=1
for ((try=1; try<=MAX_TRIES; try++)); do
  args=("${CLEAN[@]}")
  if [ "$try" -gt 1 ]; then
    client="youtube:player_client=${CLIENTS[$(( (try-2) % ${#CLIENTS[@]} ))]}"
    args+=(--extractor-args "$client")
  fi

  "$REAL" "${args[@]}" 2>>"$LOG"
  rc=$?
  if [ "$rc" -eq 0 ]; then
    exit 0
  fi
  sleep 2
done
exit "$rc"
