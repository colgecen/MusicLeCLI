#!/usr/bin/env bash
#
# musiclecli — MusicleCLI interaktif derleme aracı
#
# Kullanim:
#   ./musiclecli                    -> interaktif menü (OS sec -> format sec -> derle)
#   ./musiclecli --list             -> tüm derleme seceneklerini listele
#   ./musiclecli linux appimage     -> direkt derle (argümanli, menüsüz)
#   ./musiclecli windows exe-zip
#   ./musiclecli macos targz
#   ./musiclecli --install          -> ~/.local/bin'e sembolik bag kur,
#                                    sonra her klasörden `musiclecli` yazman yeterli
#   ./musiclecli --help             -> yardim
#
# Gecerli hedefler:
#   linux   : appimage | rpm | targz | binary
#   windows : exe | exe-zip
#   macos   : targz | binary
#
set -euo pipefail

VERSION="${VERSION:-1.3.0}"
ROOT="$(cd "$(dirname "$0")" && pwd)"

GO=$(command -v go 2>/dev/null || command -v /usr/local/go/bin/go 2>/dev/null || command -v /usr/lib/go/bin/go 2>/dev/null || true)
if [ -z "$GO" ]; then
  echo "Go bulunamadi. Kur: sudo dnf install golang"
  exit 1
fi

banner() {
  echo "=============================================="
  echo "  MusicLeCLI — musiclecli derleme araci  v$VERSION"
  echo "=============================================="
}

usage() {
  banner
  echo
  echo "Kullanim:"
  echo "  ./musiclecli                     Interaktif menü"
  echo "  ./musiclecli <os> <format>       Direkt derle"
  echo "  ./musiclecli --list              Secenekleri listele"
  echo "  ./musiclecli --install           Komutu sisteme kur (her yerden 'musiclecli')"
  echo "  ./musiclecli --help              Bu yardim"
  echo
  echo "Hedefler:"
  echo "  linux   : appimage | rpm | targz | binary"
  echo "  windows : exe | exe-zip"
  echo "  macos   : targz | binary"
  echo
  echo "Ornekler:"
  echo "  ./musiclecli linux appimage"
  echo "  ./musiclecli windows exe-zip"
  echo "  VERSION=1.4.0 ./musiclecli linux targz"
}

list_targets() {
  echo "linux   : appimage (.AppImage) | rpm (.rpm) | targz (.tar.gz) | binary (binary only)"
  echo "windows : exe (.exe) | exe-zip (.exe + .zip)"
  echo "macos   : targz (.tar.gz) | binary (binary only)"
}

do_install() {
  local bindir="$HOME/.local/bin"
  mkdir -p "$bindir"
  ln -sf "$ROOT/musiclecli" "$bindir/musiclecli"
  echo "Kuruldu: $bindir/musiclecli -> $ROOT/musiclecli"
  case ":$PATH:" in
    *":$bindir:"*) echo "PATH zaten '$bindir' iceriyor. Artik her klasorden 'musiclecli' yazabilirsin." ;;
    *)
      echo "NOT: '$bindir' PATH'te yok. Su satiri ~/.bashrc'ye ekle:"
      echo "  export PATH=\"\$HOME/.local/bin:\$PATH\""
      echo "Sonra yeni terminal ac ya da: source ~/.bashrc"
      ;;
  esac
}

# prepare_engine: gömülü motoru (yt-dlp + ffmpeg) istenen OS icin hazirlar,
# böylece `go build -tags engine_assets` onu binary'ye gömer.
prepare_engine() {
  local os="$1"
  echo "==> Gömülü motor hazirlaniyor ($os)..."
  if "$ROOT/scripts/prepare-engine.sh" "$os"; then
    echo "==> Motor hazir."
  else
    echo "UYARI: motor hazirlanamadi; build -tags engine_assets basarisiz olabilir."
  fi
}

build_linux() {
  local fmt="$1"
  mkdir -p "$ROOT/build"
  echo "==> Binary derleniyor (linux)..."
  prepare_engine linux
  # shellcheck disable=SC2086
  CGO_ENABLED=1 $GO build -tags engine_assets -ldflags="-s -w -X main.version=$VERSION" -o "$ROOT/build/musicle-cli" "$ROOT"
  upx --best --lzma "$ROOT/build/musicle-cli" 2>/dev/null || true

  case "$fmt" in
    appimage)
      echo "==> AppImage paketleniyor..."
      APPDIR="$ROOT/build/MusicLe.AppDir"
      mkdir -p "$APPDIR/usr/bin" "$APPDIR/usr/lib" "$APPDIR/usr/share/applications" "$APPDIR/usr/share/icons/hicolor/1024x1024/apps"

      echo "==> Paylasimli kutuphaneler ekleniyor..."
      for lib in $(ldd "$ROOT/build/musicle-cli" 2>/dev/null | grep '=> /' | awk '{print $3}' | sort -u); do
        case "$lib" in
          */libc.so.*|*/libpthread.so.*|*/libm.so.*|*/libdl.so.*|*/librt.so.*|*/libresolv.so.*|*/libnss_*|*/libutil.so.*|*/libgcc_s.so.*|*/libstdc++.so.*|*/ld-linux*|linux-vdso*) ;;
          *) cp -L "$lib" "$APPDIR/usr/lib/"; echo "  bundled: $lib" ;;
        esac
      done

      echo "==> yt-dlp indiriliyor..."
      YTDLP_URL="https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_linux"
      if command -v curl &>/dev/null; then
        curl -sL "$YTDLP_URL" -o "$APPDIR/usr/bin/yt-dlp"
      elif command -v wget &>/dev/null; then
        wget -q "$YTDLP_URL" -O "$APPDIR/usr/bin/yt-dlp"
      fi
      if [ -f "$APPDIR/usr/bin/yt-dlp" ]; then
        chmod +x "$APPDIR/usr/bin/yt-dlp"
        if "$APPDIR/usr/bin/yt-dlp" --version >/dev/null 2>&1; then
          echo "  yt-dlp bundled: $("$APPDIR/usr/bin/yt-dlp" --version)"
        else
          echo "  UYARI: yt-dlp bozuk gorunuyor, kaldirildi"
          rm -f "$APPDIR/usr/bin/yt-dlp"
        fi
      else
        echo "  UYARI: yt-dlp indirilemedi, calisma aninda sistem yt-dlp denenecek"
      fi

      cp "$ROOT/build/musicle-cli" "$APPDIR/usr/bin/"
      cp "$ROOT/assets/MusicLe.png" "$APPDIR/.DirIcon"
      cp "$ROOT/assets/MusicLe.png" "$APPDIR/musicle-cli.png"
      cp "$ROOT/assets/MusicLe.png" "$APPDIR/usr/share/icons/hicolor/1024x1024/apps/musicle-cli.png"

      cat > "$APPDIR/AppRun" << 'APPRUN'
#!/bin/bash
HERE="$(dirname "$(readlink -f "$0")")"
export LD_LIBRARY_PATH="$HERE/usr/lib:$LD_LIBRARY_PATH"
export APPDIR="$HERE"
if [ -t 0 ]; then
  exec "$HERE/usr/bin/musicle-cli" "$@"
else
  for term in x-terminal-emulator gnome-terminal konsole xterm alacritty kitty; do
    if command -v "$term" &>/dev/null; then
      exec "$term" -e "$HERE/usr/bin/musicle-cli" "$@"
    fi
  done
  exec "$HERE/usr/bin/musicle-cli" "$@"
fi
APPRUN
      chmod +x "$APPDIR/AppRun"

      cat > "$APPDIR/musicle-cli.desktop" << 'DESKTOP'
[Desktop Entry]
Name=MusicLe
Exec=musicle-cli
Icon=musicle-cli
Terminal=true
Type=Application
Categories=AudioVideo;Audio;Music;Player;
StartupNotify=false
DESKTOP
      cp "$APPDIR/musicle-cli.desktop" "$APPDIR/usr/share/applications/"
      wget -q https://github.com/AppImage/AppImageKit/releases/download/continuous/appimagetool-x86_64.AppImage -O "$ROOT/build/appimagetool"
      chmod +x "$ROOT/build/appimagetool"
      cd "$ROOT/build"
      ./appimagetool --appimage-extract > /dev/null 2>&1 || true
      TMP_APPIMAGE="MusicleCLI.build.AppImage"
      rm -f "$TMP_APPIMAGE"
      ./squashfs-root/AppRun -n MusicLe.AppDir "$TMP_APPIMAGE"
      mv -f "$TMP_APPIMAGE" MusicleCLI.AppImage
      rm -rf squashfs-root appimagetool MusicLe.AppDir musicle-cli
      cd "$ROOT"
      echo "==> build/MusicleCLI.AppImage"
      ;;
    rpm)
      echo "==> RPM paketleniyor..."
      mkdir -p "$ROOT/build/rpm/{BUILD,RPMS,SOURCES,SPECS,SRPMS}"
      cat > "$ROOT/build/rpm/SPECS/musicle-cli.spec" << SPEC
Name: musicle-cli
Version: $VERSION
Release: 1
Summary: Terminal music player
License: MIT
BuildArch: x86_64
%description
MusicLe - terminal music player
%install
mkdir -p %{buildroot}/usr/local/bin
cp %{_sourcedir}/musicle-cli %{buildroot}/usr/local/bin/
%files
/usr/local/bin/musicle-cli
SPEC
      cp "$ROOT/build/musicle-cli" "$ROOT/build/rpm/SOURCES/"
      rpmbuild --define "_topdir $ROOT/build/rpm" -bb "$ROOT/build/rpm/SPECS/musicle-cli.spec"
      cp "$ROOT/build/rpm/RPMS/x86_64/"*.rpm "$ROOT/build/"
      echo "==> build/*.rpm"
      ;;
    targz)
      echo "==> tar.gz paketleniyor..."
      mkdir -p "$ROOT/build/musicle-cli_Linux_x86_64"
      cp "$ROOT/build/musicle-cli" "$ROOT/build/musicle-cli_Linux_x86_64/"
      cp "$ROOT/README.md" "$ROOT/build/musicle-cli_Linux_x86_64/" 2>/dev/null || true
      cd "$ROOT/build" && tar czf musicle-cli_Linux_x86_64.tar.gz musicle-cli_Linux_x86_64 && cd "$ROOT"
      echo "==> build/musicle-cli_Linux_x86_64.tar.gz"
      ;;
    binary)
      echo "==> build/musicle-cli"
      ;;
    *)
      echo "Bilinmeyen linux formati: $fmt (gecerli: appimage | rpm | targz | binary)"
      exit 1
      ;;
  esac
}

build_windows() {
  local fmt="$1"
  mkdir -p "$ROOT/build"
  echo "==> Derleniyor (windows)..."
  prepare_engine windows
  GOOS=windows GOARCH=amd64 CGO_ENABLED=0 $GO build -tags engine_assets -ldflags="-s -w -X main.version=$VERSION" -o "$ROOT/build/musicle-cli.exe" "$ROOT"
  upx --best --lzma "$ROOT/build/musicle-cli.exe" 2>/dev/null || true
  case "$fmt" in
    exe)
      echo "==> build/musicle-cli.exe"
      ;;
    exe-zip|zip)
      mkdir -p "$ROOT/build/musicle-cli_Windows_x86_64"
      cp "$ROOT/build/musicle-cli.exe" "$ROOT/build/musicle-cli_Windows_x86_64/"
      rm -f "$ROOT/build/musicle-cli_Windows_x86_64.zip"
      cd "$ROOT/build" && zip -r musicle-cli_Windows_x86_64.zip musicle-cli_Windows_x86_64 && cd "$ROOT"
      echo "==> build/musicle-cli_Windows_x86_64.zip"
      ;;
    *)
      echo "Bilinmeyen windows formati: $fmt (gecerli: exe | exe-zip)"
      exit 1
      ;;
  esac
}

build_macos() {
  local fmt="$1"
  mkdir -p "$ROOT/build"
  echo "==> Derleniyor (macos)..."
  prepare_engine darwin
  GOOS=darwin GOARCH=amd64 CGO_ENABLED=0 $GO build -tags engine_assets -ldflags="-s -w -X main.version=$VERSION" -o "$ROOT/build/musicle-cli-darwin" "$ROOT"
  upx --best --lzma "$ROOT/build/musicle-cli-darwin" 2>/dev/null || true
  case "$fmt" in
    targz|tar.gz)
      mkdir -p "$ROOT/build/musicle-cli_macOS_x86_64"
      cp "$ROOT/build/musicle-cli-darwin" "$ROOT/build/musicle-cli_macOS_x86_64/musicle-cli"
      cp "$ROOT/README.md" "$ROOT/build/musicle-cli_macOS_x86_64/" 2>/dev/null || true
      cd "$ROOT/build" && tar czf musicle-cli_macOS_x86_64.tar.gz musicle-cli_macOS_x86_64 && cd "$ROOT"
      echo "==> build/musicle-cli_macOS_x86_64.tar.gz"
      ;;
    binary)
      echo "==> build/musicle-cli-darwin"
      ;;
    *)
      echo "Bilinmeyen macos formati: $fmt (gecerli: targz | binary)"
      exit 1
      ;;
  esac
}

build_target() {
  local os="$1" fmt="$2"
  banner
  echo "Hedef: OS=$os  Format=$fmt  Version=$VERSION"
  echo
  case "$os" in
    linux)   build_linux "$fmt" ;;
    windows) build_windows "$fmt" ;;
    macos|darwin) build_macos "$fmt" ;;
    *)
      echo "Bilinmeyen OS: $os (gecerli: linux | windows | macos)"
      exit 1
      ;;
  esac
  echo
  echo "Bitti hacim. Cikti build/ klasorunde."
}

interactive() {
  banner
  echo
  echo "Hedef isletim sistemi sec:"
  select os_choice in "Linux" "Windows" "macOS" "Vazgec"; do
    case "$os_choice" in
      Linux)   OS="linux"; break ;;
      Windows) OS="windows"; break ;;
      macOS)   OS="macos"; break ;;
      Vazgec|"") echo "Vazgecildi."; exit 0 ;;
      *) echo "Gecersiz secim, tekrar dene." ;;
    esac
  done

  echo
  case "$OS" in
    linux)
      echo "Paket formati sec:"
      select f in "AppImage (.AppImage)" "RPM (.rpm)" "tar.gz (.tar.gz)" "Binary only" "Vazgec"; do
        case "$REPLY" in
          1) FMT="appimage"; break ;;
          2) FMT="rpm"; break ;;
          3) FMT="targz"; break ;;
          4) FMT="binary"; break ;;
          5|"") echo "Vazgecildi."; exit 0 ;;
          *) echo "Gecersiz secim, tekrar dene." ;;
        esac
      done
      ;;
    windows)
      echo "Paket formati sec:"
      select f in ".exe (portable)" ".exe + .zip" "Vazgec"; do
        case "$REPLY" in
          1) FMT="exe"; break ;;
          2) FMT="exe-zip"; break ;;
          3|"") echo "Vazgecildi."; exit 0 ;;
          *) echo "Gecersiz secim, tekrar dene." ;;
        esac
      done
      ;;
    macos)
      echo "Paket formati sec:"
      select f in "tar.gz (.tar.gz)" "Binary only" "Vazgec"; do
        case "$REPLY" in
          1) FMT="targz"; break ;;
          2) FMT="binary"; break ;;
          3|"") echo "Vazgecildi."; exit 0 ;;
          *) echo "Gecersiz secim, tekrar dene." ;;
        esac
      done
      ;;
  esac

  build_target "$OS" "$FMT"
}

# ---- argüman yönlendirme ----
if [ $# -eq 0 ]; then
  interactive
  exit 0
fi

case "${1:-}" in
  -h|--help|help)
    usage
    ;;
  -l|--list|list)
    list_targets
    ;;
  --install|install)
    do_install
    ;;
  --version|-v)
    echo "musiclecli $VERSION"
    ;;
  linux|windows|macos|darwin)
    if [ $# -lt 2 ]; then
      echo "Format eksik. Ornek: ./musiclecli $1 <format>"
      list_targets
      exit 1
    fi
    OS="$1"; FMT="$2"
    # 3. argüman olarak version verilebilir: ./musiclecli linux appimage 1.4.0
    if [ $# -ge 3 ]; then
      VERSION="$3"
    fi
    build_target "$OS" "$FMT"
    ;;
  *)
    # VERSION=... ./musiclecli 1.4.0  seklinde sürümle çağrı ya da hatalı kullanım
    echo "Bilinmeyen komut: $1"
    echo
    usage
    exit 1
    ;;
esac
